{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/liuzix/RNNTranslator/schemas/baseline.schema.json",
 "title": "harness baseline",
 "description": "harness/baseline.json: the state of the project at the last accepted commit — every item of the lattice (harness/lattice.py), the aggregate metrics as views, and the detail they were taken from. check_schemas verifies that every cited sentence is in the pinned corpus split and that the metrics agree with the outputs.",
 "type": "object",
 "required": [
  "taken",
  "metrics",
  "detail",
  "outputs"
 ],
 "additionalProperties": false,
 "properties": {
  "taken": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2} at [0-9a-f]{7,40}( \\(staged\\))?$"
  },
  "metrics": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "rules.dev.covered",
    "rules.dev.bleu_all",
    "rules.test.covered",
    "rules.test.bleu_all",
    "matrix.identical",
    "matrix.silent_misfires",
    "np.mismatches",
    "negatives.accepted",
    "negatives.controls_refused",
    "negatives.matrix_accepted",
    "suites.right",
    "suites.cases",
    "suites.closed",
    "torch.diverging",
    "printer.misfire",
    "printer.sweep_mismatches"
   ],
   "properties": {
    "rules.dev.covered": {
     "type": "integer",
     "minimum": 0
    },
    "rules.dev.bleu_all": {
     "type": "number"
    },
    "rules.test.covered": {
     "type": "integer",
     "minimum": 0
    },
    "rules.test.bleu_all": {
     "type": "number"
    },
    "matrix.identical": {
     "type": "integer",
     "minimum": 0
    },
    "matrix.silent_misfires": {
     "type": "integer",
     "minimum": 0
    },
    "np.mismatches": {
     "type": "integer",
     "minimum": 0
    },
    "negatives.accepted": {
     "type": "integer",
     "minimum": 0
    },
    "negatives.controls_refused": {
     "type": "integer",
     "minimum": 0
    },
    "negatives.matrix_accepted": {
     "type": "integer",
     "minimum": 0
    },
    "suites.right": {
     "type": "integer",
     "minimum": 0
    },
    "suites.cases": {
     "type": "integer",
     "minimum": 0
    },
    "suites.closed": {
     "type": "integer",
     "minimum": 0
    },
    "torch.diverging": {
     "type": "integer",
     "minimum": 0
    },
    "printer.misfire": {
     "type": "integer",
     "minimum": 0
    },
    "printer.sweep_mismatches": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "detail": {
   "type": "object",
   "required": [
    "rules",
    "matrix",
    "np",
    "negatives",
    "suites",
    "torch",
    "printer"
   ],
   "additionalProperties": false,
   "properties": {
    "rules": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "required": [
        "n",
        "covered",
        "coverage",
        "bleu_all",
        "bleu_covered",
        "failures"
       ],
       "additionalProperties": false,
       "properties": {
        "n": {
         "type": "integer",
         "minimum": 0
        },
        "covered": {
         "type": "integer",
         "minimum": 0
        },
        "coverage": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "bleu_all": {
         "type": "number"
        },
        "bleu_covered": {
         "type": "number"
        },
        "failures": {
         "type": "object",
         "additionalProperties": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      },
      "test": {
       "type": "object",
       "required": [
        "n",
        "covered",
        "coverage",
        "bleu_all",
        "bleu_covered",
        "failures"
       ],
       "additionalProperties": false,
       "properties": {
        "n": {
         "type": "integer",
         "minimum": 0
        },
        "covered": {
         "type": "integer",
         "minimum": 0
        },
        "coverage": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "bleu_all": {
         "type": "number"
        },
        "bleu_covered": {
         "type": "number"
        },
        "failures": {
         "type": "object",
         "additionalProperties": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      }
     }
    },
    "matrix": {
     "type": "object",
     "required": [
      "identical",
      "wrong_frame",
      "matrix_parses_refused",
      "refused_parseable",
      "both_refuse",
      "cell",
      "per_split",
      "summary"
     ],
     "properties": {
      "identical": {
       "type": "integer",
       "minimum": 0
      },
      "wrong_frame": {
       "type": "integer",
       "minimum": 0
      },
      "matrix_parses_refused": {
       "type": "integer",
       "minimum": 0
      },
      "refused_parseable": {
       "type": "integer",
       "minimum": 0
      },
      "both_refuse": {
       "type": "integer",
       "minimum": 0
      },
      "cell": {
       "type": "object",
       "required": [
        "encoder",
        "decoder",
        "frame_units",
        "sentence_units",
        "output_units",
        "nnz",
        "rules",
        "canon"
       ],
       "properties": {
        "canon": {
         "type": "object",
         "description": "the canonical diagrams of both cells (canon.py): how many control points are complete and consistent, the nodes in all, the README's example in text form",
         "required": [
          "control_points",
          "complete",
          "consistent",
          "nodes",
          "example"
         ],
         "additionalProperties": true,
         "properties": {
          "control_points": {
           "type": "integer"
          },
          "complete": {
           "type": "integer"
          },
          "consistent": {
           "type": "integer"
          },
          "nodes": {
           "type": "integer"
          },
          "example": {
           "type": "string"
          }
         }
        },
        "encoder": {
         "type": "object",
         "required": [
          "state_units",
          "input_units",
          "nnz",
          "layers",
          "rules"
         ],
         "properties": {
          "state_units": {
           "type": "integer"
          },
          "input_units": {
           "type": "integer"
          },
          "nnz": {
           "type": "integer"
          },
          "rules": {
           "type": "integer"
          },
          "layers": {
           "type": "array",
           "items": {
            "type": "integer"
           }
          }
         }
        },
        "decoder": {
         "type": "object",
         "required": [
          "state_units",
          "input_units",
          "nnz",
          "layers",
          "rules"
         ],
         "properties": {
          "state_units": {
           "type": "integer"
          },
          "input_units": {
           "type": "integer"
          },
          "nnz": {
           "type": "integer"
          },
          "rules": {
           "type": "integer"
          },
          "layers": {
           "type": "array",
           "items": {
            "type": "integer"
           }
          }
         }
        },
        "frame_units": {
         "type": "integer"
        },
        "sentence_units": {
         "type": "integer"
        },
        "output_units": {
         "type": "integer"
        },
        "nnz": {
         "type": "integer"
        },
        "rules": {
         "type": "integer"
        }
       },
       "description": "the compiled machine: the encoder cell and the decoder cell, the size of what passes between them (a frame of the context, the sentence block) and of the decoder's output block"
      },
      "per_split": {
       "type": "object"
      },
      "summary": {
       "type": "string"
      }
     }
    },
    "np": {
     "type": "object",
     "required": [
      "cases",
      "mismatches",
      "max_len",
      "alphabet"
     ],
     "properties": {
      "cases": {
       "type": "integer",
       "minimum": 0
      },
      "mismatches": {
       "type": "integer",
       "minimum": 0
      },
      "max_len": {
       "type": "integer",
       "minimum": 0
      },
      "alphabet": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "negatives": {
     "type": "object",
     "required": [
      "count",
      "accepted",
      "controls_refused_by_rules",
      "controls_refused_by_matrix",
      "matrix_accepted"
     ],
     "properties": {
      "count": {
       "type": "integer",
       "minimum": 1
      },
      "accepted": {
       "type": "integer",
       "minimum": 0
      },
      "controls_refused_by_rules": {
       "type": "integer",
       "minimum": 0
      },
      "controls_refused_by_matrix": {
       "type": "integer",
       "minimum": 0
      },
      "matrix_accepted": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "suites": {
     "type": "object",
     "required": [
      "classes",
      "cases",
      "right",
      "closed",
      "open"
     ],
     "properties": {
      "classes": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "required": [
         "title",
         "cases",
         "right",
         "refused",
         "wrong",
         "closed"
        ]
       }
      },
      "cases": {
       "type": "integer"
      },
      "right": {
       "type": "integer"
      },
      "closed": {
       "type": "integer"
      },
      "open": {
       "type": "integer"
      }
     }
    },
    "torch": {
     "type": "object",
     "required": [
      "sentences",
      "steps",
      "diverging",
      "torch",
      "dtype"
     ],
     "description": "the torch action: the scipy and torch runners stepped side by side on every dev and test sentence",
     "properties": {
      "sentences": {
       "type": "integer",
       "minimum": 0
      },
      "steps": {
       "type": "integer",
       "minimum": 0
      },
      "diverging": {
       "type": "integer",
       "minimum": 0
      },
      "torch": {
       "type": "string"
      },
      "dtype": {
       "type": "string"
      }
     }
    },
    "printer": {
     "type": "object",
     "required": [
      "agree",
      "gap",
      "misfire",
      "rules",
      "positions",
      "sweep",
      "per_split"
     ],
     "description": "the printer action: the printing rules of gen_module against generate() on every parsed sentence and on the sweep",
     "properties": {
      "agree": {
       "type": "integer",
       "minimum": 0
      },
      "gap": {
       "type": "integer",
       "minimum": 0
      },
      "misfire": {
       "type": "integer",
       "minimum": 0
      },
      "rules": {
       "type": "integer",
       "minimum": 0
      },
      "positions": {
       "type": "integer",
       "minimum": 0
      },
      "sweep": {
       "type": "object",
       "required": [
        "frames",
        "match",
        "mismatches",
        "refused",
        "generate_crash"
       ],
       "properties": {
        "frames": {
         "type": "integer",
         "minimum": 0
        },
        "match": {
         "type": "integer",
         "minimum": 0
        },
        "mismatches": {
         "type": "integer",
         "minimum": 0
        },
        "refused": {
         "type": "integer",
         "minimum": 0
        },
        "generate_crash": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    }
   }
  },
  "outputs": {
   "type": "object",
   "required": [
    "rules",
    "matrix",
    "negatives",
    "refusals",
    "suites",
    "printer"
   ],
   "additionalProperties": false,
   "description": "the items of the lattice: per split, '<line>: <sentence>' -> the rule transducer's Japanese ('' = refused) and the matrix parser's; the negatives rows; the refusal reason per refused sentence; per split, the printing rules' Japanese for every parsed sentence ('' = refused)",
   "properties": {
    "rules": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      },
      "test": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      }
     }
    },
    "matrix": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      },
      "test": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      }
     }
    },
    "refusals": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      },
      "test": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      }
     }
    },
    "negatives": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "sentence",
       "control",
       "sentence.rules",
       "sentence.matrix",
       "control.rules",
       "control.matrix"
      ],
      "properties": {
       "sentence": {
        "type": "string"
       },
       "control": {
        "type": "string"
       }
      }
     }
    },
    "suites": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "class",
       "sentence",
       "expect",
       "output",
       "level"
      ],
      "properties": {
       "class": {
        "type": "string"
       },
       "sentence": {
        "type": "string"
       },
       "expect": {
        "type": "string"
       },
       "output": {
        "type": "string"
       },
       "level": {
        "enum": [
         "RIGHT",
         "REFUSED",
         "WRONG"
        ]
       }
      }
     }
    },
    "printer": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      },
      "test": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      }
     }
    }
   }
  }
 }
}
