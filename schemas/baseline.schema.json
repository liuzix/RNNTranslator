{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/liuzix/RNNTranslator/schemas/baseline.schema.json",
 "title": "harness baseline",
 "description": "harness/baseline.json: the state of the project at the last accepted commit — every item of the lattice (harness/lattice.py), the aggregate metrics as views, and the detail they were taken from. check_schemas verifies that every cited sentence is in the pinned corpus split and that the metrics agree with the outputs.",
 "type": "object",
 "required": [
  "taken",
  "metrics",
  "detail",
  "outputs"
 ],
 "additionalProperties": false,
 "properties": {
  "taken": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2} at [0-9a-f]{7,40}( \\(staged\\))?$"
  },
  "metrics": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "rules.dev.covered",
    "rules.dev.bleu_all",
    "rules.test.covered",
    "rules.test.bleu_all",
    "matrix.identical",
    "matrix.silent_misfires",
    "np.mismatches",
    "negatives.accepted",
    "negatives.controls_refused",
    "negatives.matrix_accepted",
    "suites.right",
    "suites.cases",
    "suites.closed"
   ],
   "properties": {
    "rules.dev.covered": {
     "type": "integer",
     "minimum": 0
    },
    "rules.dev.bleu_all": {
     "type": "number"
    },
    "rules.test.covered": {
     "type": "integer",
     "minimum": 0
    },
    "rules.test.bleu_all": {
     "type": "number"
    },
    "matrix.identical": {
     "type": "integer",
     "minimum": 0
    },
    "matrix.silent_misfires": {
     "type": "integer",
     "minimum": 0
    },
    "np.mismatches": {
     "type": "integer",
     "minimum": 0
    },
    "negatives.accepted": {
     "type": "integer",
     "minimum": 0
    },
    "negatives.controls_refused": {
     "type": "integer",
     "minimum": 0
    },
    "negatives.matrix_accepted": {
     "type": "integer",
     "minimum": 0
    },
    "suites.right": {
     "type": "integer",
     "minimum": 0
    },
    "suites.cases": {
     "type": "integer",
     "minimum": 0
    },
    "suites.closed": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "detail": {
   "type": "object",
   "required": [
    "rules",
    "matrix",
    "np",
    "negatives",
    "suites"
   ],
   "additionalProperties": false,
   "properties": {
    "rules": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "required": [
        "n",
        "covered",
        "coverage",
        "bleu_all",
        "bleu_covered",
        "failures"
       ],
       "additionalProperties": false,
       "properties": {
        "n": {
         "type": "integer",
         "minimum": 0
        },
        "covered": {
         "type": "integer",
         "minimum": 0
        },
        "coverage": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "bleu_all": {
         "type": "number"
        },
        "bleu_covered": {
         "type": "number"
        },
        "failures": {
         "type": "object",
         "additionalProperties": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      },
      "test": {
       "type": "object",
       "required": [
        "n",
        "covered",
        "coverage",
        "bleu_all",
        "bleu_covered",
        "failures"
       ],
       "additionalProperties": false,
       "properties": {
        "n": {
         "type": "integer",
         "minimum": 0
        },
        "covered": {
         "type": "integer",
         "minimum": 0
        },
        "coverage": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "bleu_all": {
         "type": "number"
        },
        "bleu_covered": {
         "type": "number"
        },
        "failures": {
         "type": "object",
         "additionalProperties": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      }
     }
    },
    "matrix": {
     "type": "object",
     "required": [
      "identical",
      "wrong_frame",
      "matrix_parses_refused",
      "refused_parseable",
      "both_refuse",
      "cell",
      "per_split",
      "summary"
     ],
     "properties": {
      "identical": {
       "type": "integer",
       "minimum": 0
      },
      "wrong_frame": {
       "type": "integer",
       "minimum": 0
      },
      "matrix_parses_refused": {
       "type": "integer",
       "minimum": 0
      },
      "refused_parseable": {
       "type": "integer",
       "minimum": 0
      },
      "both_refuse": {
       "type": "integer",
       "minimum": 0
      },
      "cell": {
       "type": "object",
       "required": [
        "state_units",
        "input_units",
        "nnz",
        "rules"
       ]
      },
      "per_split": {
       "type": "object"
      },
      "summary": {
       "type": "string"
      }
     }
    },
    "np": {
     "type": "object",
     "required": [
      "cases",
      "mismatches",
      "max_len",
      "alphabet"
     ],
     "properties": {
      "cases": {
       "type": "integer",
       "minimum": 0
      },
      "mismatches": {
       "type": "integer",
       "minimum": 0
      },
      "max_len": {
       "type": "integer",
       "minimum": 0
      },
      "alphabet": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "negatives": {
     "type": "object",
     "required": [
      "count",
      "accepted",
      "controls_refused_by_rules",
      "controls_refused_by_matrix",
      "matrix_accepted"
     ],
     "properties": {
      "count": {
       "type": "integer",
       "minimum": 1
      },
      "accepted": {
       "type": "integer",
       "minimum": 0
      },
      "controls_refused_by_rules": {
       "type": "integer",
       "minimum": 0
      },
      "controls_refused_by_matrix": {
       "type": "integer",
       "minimum": 0
      },
      "matrix_accepted": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "suites": {
     "type": "object",
     "required": [
      "classes",
      "cases",
      "right",
      "closed",
      "open"
     ],
     "properties": {
      "classes": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "required": [
         "title",
         "cases",
         "right",
         "refused",
         "wrong",
         "closed"
        ]
       }
      },
      "cases": {
       "type": "integer"
      },
      "right": {
       "type": "integer"
      },
      "closed": {
       "type": "integer"
      },
      "open": {
       "type": "integer"
      }
     }
    }
   }
  },
  "outputs": {
   "type": "object",
   "required": [
    "rules",
    "matrix",
    "negatives",
    "refusals",
    "suites"
   ],
   "additionalProperties": false,
   "description": "the items of the lattice: per split, '<line>: <sentence>' -> the rule transducer's Japanese ('' = refused) and the matrix parser's; the negatives rows; the refusal reason per refused sentence",
   "properties": {
    "rules": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      },
      "test": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      }
     }
    },
    "matrix": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      },
      "test": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      }
     }
    },
    "refusals": {
     "type": "object",
     "required": [
      "dev",
      "test"
     ],
     "additionalProperties": false,
     "properties": {
      "dev": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      },
      "test": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "pattern": "^[1-9]\\d*: \\S(.*\\S)?$"
       }
      }
     }
    },
    "negatives": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "sentence",
       "control",
       "sentence.rules",
       "sentence.matrix",
       "control.rules",
       "control.matrix"
      ],
      "properties": {
       "sentence": {
        "type": "string"
       },
       "control": {
        "type": "string"
       }
      }
     }
    },
    "suites": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "class",
       "sentence",
       "expect",
       "output",
       "level"
      ],
      "properties": {
       "class": {
        "type": "string"
       },
       "sentence": {
        "type": "string"
       },
       "expect": {
        "type": "string"
       },
       "output": {
        "type": "string"
       },
       "level": {
        "enum": [
         "RIGHT",
         "REFUSED",
         "WRONG"
        ]
       }
      }
     }
    }
   }
  }
 }
}