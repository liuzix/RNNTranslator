{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/liuzix/RNNTranslator/schemas/integrity.schema.json",
 "title": "table integrity declarations",
 "description": "The format of schemas/tables/integrity.json: uniqueness constraints and foreign-key style references between tables, checked by harness/check_schemas.py after the per-row schemas.",
 "type": "object",
 "required": [
  "unique",
  "references"
 ],
 "additionalProperties": false,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "unique": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "table",
     "fields"
    ],
    "additionalProperties": false,
    "properties": {
     "table": {
      "type": "string"
     },
     "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "references": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "to",
     "level"
    ],
    "additionalProperties": false,
    "properties": {
     "from": {
      "type": "object",
      "required": [
       "table",
       "field"
      ],
      "additionalProperties": false,
      "properties": {
       "table": {
        "type": "string"
       },
       "field": {
        "type": "string"
       },
       "token": {
        "type": "integer",
        "description": "for a space-separated pattern field: which token carries the key (0 first, -1 last)"
       },
       "where": {
        "type": "object",
        "additionalProperties": {
         "type": "string"
        },
        "description": "only rows whose fields equal these values"
       }
      }
     },
     "to": {
      "type": "object",
      "required": [
       "table",
       "field"
      ],
      "additionalProperties": false,
      "properties": {
       "table": {
        "type": "string"
       },
       "field": {
        "type": "string"
       },
       "token": {
        "type": "integer",
        "description": "for a space-separated pattern field: which token carries the key (0 first, -1 last)"
       },
       "where": {
        "type": "object",
        "additionalProperties": {
         "type": "string"
        },
        "description": "only rows whose fields equal these values"
       }
      }
     },
     "level": {
      "enum": [
       "error",
       "warn"
      ]
     }
    }
   }
  }
 }
}